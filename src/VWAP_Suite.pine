//@version=6
indicator("oTrade VWAP", overlay = true, dynamic_requests = true, max_labels_count = 20, max_polylines_count = 10, max_lines_count = 10)

// Overlay-Engine im festen Berechnungs-Timeframe. Plots und Zeichenobjekte nur im Chart-Kontext.

const string ANCHOR_TZ = "UTC"
const int DAY_MS = 86400000
const int RS_OK = 0
const int RS_MISSING_PREFIX = 1
const int RS_NO_VOLUME = 2
const int RS_INVALID = 3
const int RS_NO_EVENT = 4
const int RS_SEEDED = 5
const int RS_AVAILABLE = 6
const int DAY_BASELINE_CAP = 400
const int SWING_POINT_CAP = 8000

string GRP_VWAP = "VWAP"
string GRP_LABEL = "Beschriftung"
string GRP_CALC = "Berechnung und Daten"
string GRP_SWING = "Swing"
string GRP_REC = "ATH/ATL - Datenpruefung"
string GRP_SEED_ATH = "ATH/ATL - Historischer Startbestand ATH"
string GRP_SEED_ATL = "ATH/ATL - Historischer Startbestand ATL"

bool showDaily = input.bool(false, "Daily VWAP", inline = "daily", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colDaily = input.color(color.new(#FFEB3B, 0), "", inline = "daily", group = GRP_VWAP, display = display.none)
bool showWeekly = input.bool(true, "Weekly VWAP", inline = "weekly", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colWeekly = input.color(color.new(#4CAF50, 0), "", inline = "weekly", group = GRP_VWAP, display = display.none)
bool showMonthly = input.bool(true, "Monthly VWAP", inline = "monthly", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colMonthly = input.color(color.new(#2962FF, 0), "", inline = "monthly", group = GRP_VWAP, display = display.none)
bool showAth = input.bool(false, "ATH VWAP", inline = "ath", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colAth = input.color(color.new(#FFFFFF, 0), "", inline = "ath", group = GRP_VWAP, display = display.none)
bool showAtl = input.bool(false, "ATL VWAP", inline = "atl", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colAtl = input.color(color.new(#FFFFFF, 0), "", inline = "atl", group = GRP_VWAP, display = display.none)
bool showSwing = input.bool(true, "Swing VWAP", inline = "swing", group = GRP_VWAP, tooltip = "Steuert beide Swing-Linien (High und Low) und deren Labels.", display = display.none)
color colSwing = input.color(color.new(#673AB7, 0), "", inline = "swing", group = GRP_VWAP, display = display.none)
int swingWidth = input.int(2, "Width", minval = 1, maxval = 4, inline = "swing", group = GRP_VWAP, display = display.none)
bool showRegularLabels = input.bool(true, "Label VWAPs", group = GRP_VWAP, display = display.none)
bool showSwingLabels = input.bool(true, "Label Swing VWAP", group = GRP_VWAP, display = display.none)

bool showAnchorDate = input.bool(true, "Ankerdatum anzeigen", group = GRP_LABEL, tooltip = "Datum des Berechnungsbeginns in UTC, nicht der spaeteren Erkennung eines Swings.", display = display.none)
string labelSizeName = input.string("Klein", "Label-Groesse", options = ["Sehr klein", "Klein", "Normal"], group = GRP_LABEL, display = display.none)
int extraLabelOffset = input.int(0, "Zusaetzlicher Abstand (Kerzen)", minval = 0, maxval = 30, group = GRP_LABEL, tooltip = "0 verankert das Label direkt am Linienende. Zusaetzliche Kerzenabstaende veraendern sich beim Zoomen.", display = display.none)
bool showBasisInLabel = input.bool(false, "Berechnungsbasis im Label", group = GRP_LABEL, display = display.none)

string calcTf = input.string("1", "Berechnungsintervall", options = ["1", "5", "15", "60"], group = GRP_CALC, tooltip = "Bestimmt die Preis-/Volumenbasis. Ein anderes Intervall kann einen anderen VWAP ergeben.", display = display.none)
string priceSrc = input.string("HLC3", "Preisquelle", options = ["HLC3", "HL2", "Close", "OHLC4"], group = GRP_CALC, display = display.none)
string hintMode = input.string("Nur bei Einschraenkungen", "Datenhinweise", options = ["Nur bei Einschraenkungen", "Details"], group = GRP_CALC, display = display.none)
int requestedSourceBars = input.int(100000, "Quellhistorie anfordern", minval = 1, maxval = 200000, group = GRP_CALC, display = display.none)

string swingTf = input.string("60", "Swing-Timeframe", options = ["60", "240", "D"], group = GRP_SWING, display = display.none)
int pivotLeft = input.int(3, "Pivot links", minval = 1, maxval = 20, group = GRP_SWING, display = display.none)
int pivotRight = input.int(3, "Pivot rechts", minval = 1, maxval = 20, group = GRP_SWING, tooltip = "Der Swing wird erst nach Abschluss dieser Anzahl rechter Swing-Kerzen bestaetigt.", display = display.none)

bool recordVerified = input.bool(false, "Rekordhistorie manuell geprueft", group = GRP_REC, display = display.none)
int verifiedStart = input.time(1483228800000, "Gepruefter Historienbeginn UTC", group = GRP_REC, display = display.none)

bool seedAthOn = input.bool(false, "ATH-Startbestand aktiv", group = GRP_SEED_ATH, tooltip = "Nur Summen derselben Preisquelle, Kerzengroesse, Volumeneinheit und desselben Symbols verwenden.", display = display.none)
string seedAthSymbol = input.string("", "ATH Seed Symbol", group = GRP_SEED_ATH, display = display.none)
string seedAthTf = input.string("1", "ATH Seed Intervall", options = ["1", "5", "15", "60"], group = GRP_SEED_ATH, display = display.none)
string seedAthSrc = input.string("HLC3", "ATH Seed Quelle", options = ["HLC3", "HL2", "Close", "OHLC4"], group = GRP_SEED_ATH, display = display.none)
int seedAthAnchor = input.time(1577836800000, "ATH Ankerzeit UTC", group = GRP_SEED_ATH, display = display.none)
int seedAthUntil = input.time(1704067200000, "ATH Stichtag exklusiv UTC", group = GRP_SEED_ATH, display = display.none)
float seedAthPv = input.float(0.0, "ATH seedPV", group = GRP_SEED_ATH, display = display.none)
float seedAthV = input.float(0.0, "ATH seedV", minval = 0.0, group = GRP_SEED_ATH, display = display.none)
float seedAthExtreme = input.float(0.0, "ATH Extrempreis (0 = unbekannt)", group = GRP_SEED_ATH, display = display.none)

bool seedAtlOn = input.bool(false, "ATL-Startbestand aktiv", group = GRP_SEED_ATL, display = display.none)
string seedAtlSymbol = input.string("", "ATL Seed Symbol", group = GRP_SEED_ATL, display = display.none)
string seedAtlTf = input.string("1", "ATL Seed Intervall", options = ["1", "5", "15", "60"], group = GRP_SEED_ATL, display = display.none)
string seedAtlSrc = input.string("HLC3", "ATL Seed Quelle", options = ["HLC3", "HL2", "Close", "OHLC4"], group = GRP_SEED_ATL, display = display.none)
int seedAtlAnchor = input.time(1577836800000, "ATL Ankerzeit UTC", group = GRP_SEED_ATL, display = display.none)
int seedAtlUntil = input.time(1704067200000, "ATL Stichtag exklusiv UTC", group = GRP_SEED_ATL, display = display.none)
float seedAtlPv = input.float(0.0, "ATL seedPV", group = GRP_SEED_ATL, display = display.none)
float seedAtlV = input.float(0.0, "ATL seedV", minval = 0.0, group = GRP_SEED_ATL, display = display.none)
float seedAtlExtreme = input.float(0.0, "ATL Extrempreis (0 = unbekannt)", group = GRP_SEED_ATL, display = display.none)

type Snap
    float daily
    int dailyAnchor
    int dailyReason
    float weekly
    int weeklyAnchor
    int weeklyReason
    float monthly
    int monthlyAnchor
    int monthlyReason
    float ath
    int athAnchor
    int athEvent
    int athReason
    float atl
    int atlAnchor
    int atlEvent
    int atlReason
    float sh
    int shAnchor
    int shEvent
    int shKnown
    int shReason
    float sl
    int slAnchor
    int slEvent
    int slKnown
    int slReason
    int srcFirst
    int srcTime
    int dailyOlderAth
    int dailyOlderAtl
    int swingConflict
    int seededAth
    int seededAtl

f_utcDayStart(int ts) =>
    timestamp(ANCHOR_TZ, year(ts, ANCHOR_TZ), month(ts, ANCHOR_TZ), dayofmonth(ts, ANCHOR_TZ), 0, 0)

f_utcWeekStart(int ts) =>
    int dayStart = f_utcDayStart(ts)
    int daysSinceMonday = (dayofweek(ts, ANCHOR_TZ) - dayofweek.monday + 7) % 7
    dayStart - daysSinceMonday * DAY_MS

f_utcMonthStart(int ts) =>
    timestamp(ANCHOR_TZ, year(ts, ANCHOR_TZ), month(ts, ANCHOR_TZ), 1, 0, 0)

f_price() =>
    switch priceSrc
        "HL2" => hl2
        "Close" => close
        "OHLC4" => ohlc4
        => hlc3

f_labelSize() =>
    switch labelSizeName
        "Sehr klein" => size.tiny
        "Normal" => size.normal
        => size.small

f_plotColor(color userColor) =>
    color.new(userColor, color.t(userColor))

f_symbolMatches(string seedSymbol) =>
    seedSymbol == "" or seedSymbol == ticker.standard(syminfo.tickerid) or seedSymbol == syminfo.ticker

f_seedValid(bool on, string seedSymbol, string seedTf, string seedSource, int anchorTs, int untilTs, float seedV, int srcFirst) =>
    bool ok = on
    if not f_symbolMatches(seedSymbol)
        ok := false
    if seedTf != calcTf
        ok := false
    if seedSource != priceSrc
        ok := false
    if untilTs < anchorTs
        ok := false
    if na(srcFirst) or srcFirst > untilTs
        ok := false
    if na(seedV) or seedV < 0
        ok := false
    if time < untilTs
        ok := false
    ok

f_periodVwap(float pv, float vol, bool invalid, bool complete) =>
    int reason = RS_OK
    float value = na
    if invalid
        reason := RS_INVALID
    else if not complete
        reason := RS_MISSING_PREFIX
    else if vol <= 0
        reason := RS_NO_VOLUME
    else
        value := pv / vol
    [value, reason]

f_eventVwap(float cumPv, float cumV, float pvBefore, float vBefore, bool invalid, bool missing, bool seeded, bool availableOnly) =>
    int reason = RS_OK
    float value = na
    float den = cumV - vBefore
    if missing
        reason := RS_MISSING_PREFIX
    else if invalid
        reason := RS_INVALID
    else if na(pvBefore) or na(vBefore) or den <= 0
        reason := RS_NO_VOLUME
    else
        value := (cumPv - pvBefore) / den
        if seeded
            reason := RS_SEEDED
        else if availableOnly
            reason := RS_AVAILABLE
    [value, reason]

f_dailyPack() =>
    var float recH = na
    var int recHt = na
    var float recL = na
    var int recLt = na
    var int firstT = na
    if na(firstT)
        firstT := time
    if na(recH) or high > recH
        recH := high
        recHt := time
    if na(recL) or low < recL
        recL := low
        recLt := time
    [recH, recHt, recL, recLt, firstT]

f_swingPack() =>
    float ph = ta.pivothigh(high, pivotLeft, pivotRight)
    float pl = ta.pivotlow(low, pivotLeft, pivotRight)
    bool fireH = not na(ph[pivotRight])
    bool fireL = not na(pl[pivotRight])
    var int highPivotTime = na
    var int highKnownAt = na
    var float highPrice = na
    var int lowPivotTime = na
    var int lowKnownAt = na
    var float lowPrice = na
    var int conflict = 0
    if fireH and fireL
        conflict := 1
    else
        conflict := 0
        if fireH
            int pt = time[pivotRight]
            if na(highPivotTime) or pt != highPivotTime
                highPivotTime := pt
                highKnownAt := time_close
                highPrice := ph[pivotRight]
        if fireL
            int pt = time[pivotRight]
            if na(lowPivotTime) or pt != lowPivotTime
                lowPivotTime := pt
                lowKnownAt := time_close
                lowPrice := pl[pivotRight]
    [highPivotTime, highKnownAt, highPrice, lowPivotTime, lowKnownAt, lowPrice, conflict]

f_trimDayBaselines(array<int> keys, array<float> pvs, array<float> vs) =>
    if array.size(keys) > DAY_BASELINE_CAP
        array.shift(keys)
        array.shift(pvs)
        array.shift(vs)

f_lookupPrefix(array<int> keys, array<float> pvs, array<float> vs, int dayStart) =>
    int idx = array.indexof(keys, dayStart)
    float pvB = idx >= 0 ? array.get(pvs, idx) : na
    float vB = idx >= 0 ? array.get(vs, idx) : na
    [pvB, vB]

f_pushBarPrefix(array<int> times, array<float> pvs, array<float> vs, int t, float pv, float vol) =>
    array.push(times, t)
    array.push(pvs, pv)
    array.push(vs, vol)
    if array.size(times) > SWING_POINT_CAP
        array.shift(times)
        array.shift(pvs)
        array.shift(vs)
    true

f_lookupBarPrefix(array<int> times, array<float> pvs, array<float> vs, int pivotTime) =>
    int idx = array.indexof(times, pivotTime)
    float pvB = idx >= 0 ? array.get(pvs, idx) : na
    float vB = idx >= 0 ? array.get(vs, idx) : na
    [pvB, vB]

f_engine() =>
    [dAthPx, dAthT, dAtlPx, dAtlT, dFirst] = request.security(syminfo.tickerid, "1D", f_dailyPack(), barmerge.gaps_off, barmerge.lookahead_off)
    [hPt, hKn, hPx, lPt, lKn, lPx, conflict] = request.security(syminfo.tickerid, swingTf, f_swingPack(), barmerge.gaps_off, barmerge.lookahead_off)

    var int srcFirst = na
    var float cumPv = 0.0
    var float cumV = 0.0
    var int prevDay = na
    var int prevWeek = na
    var int prevMonth = na
    var int dayAnchor = na
    var int weekAnchor = na
    var int monthAnchor = na
    var float dayPv = 0.0
    var float dayV = 0.0
    var float weekPv = 0.0
    var float weekV = 0.0
    var float monthPv = 0.0
    var float monthV = 0.0
    var bool dayInvalid = false
    var bool weekInvalid = false
    var bool monthInvalid = false
    var array<int> dayKeys = array.new_int()
    var array<float> dayPvBefore = array.new_float()
    var array<float> dayVBefore = array.new_float()
    var float recHigh = na
    var float recLow = na
    var int athAnchor = na
    var int atlAnchor = na
    var float athPvBefore = na
    var float athVBefore = na
    var float atlPvBefore = na
    var float atlVBefore = na
    var bool athInvalid = false
    var bool atlInvalid = false
    var bool athUseSeed = false
    var bool atlUseSeed = false
    var float athSeedPvBefore = na
    var float athSeedVBefore = na
    var float atlSeedPvBefore = na
    var float atlSeedVBefore = na
    var bool athSeedInit = false
    var bool atlSeedInit = false
    var int shAnchor = na
    var int shEvent = na
    var int shKnown = na
    var float shPvBefore = na
    var float shVBefore = na
    var bool shInvalid = false
    var bool shMissing = false
    var int slAnchor = na
    var int slEvent = na
    var int slKnown = na
    var float slPvBefore = na
    var float slVBefore = na
    var bool slInvalid = false
    var bool slMissing = false
    var int lastHPt = na
    var int lastLPt = na
    var array<int> barPrefixTimes = array.new_int()
    var array<float> barPrefixPv = array.new_float()
    var array<float> barPrefixV = array.new_float()

    if na(srcFirst)
        srcFirst := time

    int dayKey = f_utcDayStart(time)
    int weekKey = f_utcWeekStart(time)
    int monthKey = f_utcMonthStart(time)
    bool newDay = na(prevDay) or dayKey != prevDay
    bool newWeek = na(prevWeek) or weekKey != prevWeek
    bool newMonth = na(prevMonth) or monthKey != prevMonth

    if newDay
        dayAnchor := dayKey
        dayPv := 0.0
        dayV := 0.0
        dayInvalid := false
        array.push(dayKeys, dayKey)
        array.push(dayPvBefore, cumPv)
        array.push(dayVBefore, cumV)
        f_trimDayBaselines(dayKeys, dayPvBefore, dayVBefore)
    if newWeek
        weekAnchor := weekKey
        weekPv := 0.0
        weekV := 0.0
        weekInvalid := false
    if newMonth
        monthAnchor := monthKey
        monthPv := 0.0
        monthV := 0.0
        monthInvalid := false

    float p = f_price()
    float v = volume
    int contribState = 0
    if na(v) or v < 0 or (v > 0 and na(p))
        contribState := 2
    else if v > 0
        contribState := 1

    f_pushBarPrefix(barPrefixTimes, barPrefixPv, barPrefixV, time, cumPv, cumV)

    bool newAth = na(recHigh) or high > recHigh
    bool newAtl = na(recLow) or low < recLow
    if newAth
        recHigh := high
        if not athUseSeed or (seedAthExtreme > 0 and high > seedAthExtreme)
            athAnchor := time
            athPvBefore := cumPv
            athVBefore := cumV
            athInvalid := false
            if athUseSeed and seedAthExtreme > 0 and high > seedAthExtreme
                athUseSeed := false
    if newAtl
        recLow := low
        if not atlUseSeed or (seedAtlExtreme > 0 and low < seedAtlExtreme)
            atlAnchor := time
            atlPvBefore := cumPv
            atlVBefore := cumV
            atlInvalid := false
            if atlUseSeed and seedAtlExtreme > 0 and low < seedAtlExtreme
                atlUseSeed := false

    if contribState == 2
        dayInvalid := true
        weekInvalid := true
        monthInvalid := true
        athInvalid := true
        atlInvalid := true
        shInvalid := true
        slInvalid := true
    else if contribState == 1
        float pv = p * v
        cumPv += pv
        cumV += v
        dayPv += pv
        dayV += v
        weekPv += pv
        weekV += v
        monthPv += pv
        monthV += v

    bool athSeedOk = f_seedValid(seedAthOn, seedAthSymbol, seedAthTf, seedAthSrc, seedAthAnchor, seedAthUntil, seedAthV, srcFirst)
    bool atlSeedOk = f_seedValid(seedAtlOn, seedAtlSymbol, seedAtlTf, seedAtlSrc, seedAtlAnchor, seedAtlUntil, seedAtlV, srcFirst)
    if athSeedOk and not athSeedInit and time >= seedAthUntil
        athSeedPvBefore := cumPv - (contribState == 1 ? p * v : 0.0)
        athSeedVBefore := cumV - (contribState == 1 ? v : 0.0)
        athSeedInit := true
        athUseSeed := true
        athAnchor := seedAthAnchor
        athInvalid := false
    if atlSeedOk and not atlSeedInit and time >= seedAtlUntil
        atlSeedPvBefore := cumPv - (contribState == 1 ? p * v : 0.0)
        atlSeedVBefore := cumV - (contribState == 1 ? v : 0.0)
        atlSeedInit := true
        atlUseSeed := true
        atlAnchor := seedAtlAnchor
        atlInvalid := false

    if not na(hPt) and (na(lastHPt) or hPt != lastHPt)
        shAnchor := hPt
        shEvent := hPt
        shKnown := hKn
        [pvB, vB] = f_lookupBarPrefix(barPrefixTimes, barPrefixPv, barPrefixV, hPt)
        shPvBefore := pvB
        shVBefore := vB
        shMissing := na(pvB)
        shInvalid := false
        lastHPt := hPt
    if not na(lPt) and (na(lastLPt) or lPt != lastLPt)
        slAnchor := lPt
        slEvent := lPt
        slKnown := lKn
        [pvB2, vB2] = f_lookupBarPrefix(barPrefixTimes, barPrefixPv, barPrefixV, lPt)
        slPvBefore := pvB2
        slVBefore := vB2
        slMissing := na(pvB2)
        slInvalid := false
        lastLPt := lPt

    prevDay := dayKey
    prevWeek := weekKey
    prevMonth := monthKey

    [dailyVal, dailyReason] = f_periodVwap(dayPv, dayV, dayInvalid, srcFirst <= dayAnchor)
    [weeklyVal, weeklyReason] = f_periodVwap(weekPv, weekV, weekInvalid, srcFirst <= weekAnchor)
    [monthlyVal, monthlyReason] = f_periodVwap(monthPv, monthV, monthInvalid, srcFirst <= monthAnchor)

    bool dailyOlderAth = not na(dAthT) and not na(srcFirst) and dAthT < srcFirst
    bool dailyOlderAtl = not na(dAtlT) and not na(srcFirst) and dAtlT < srcFirst
    bool athAvailable = not recordVerified or verifiedStart > srcFirst
    bool atlAvailable = not recordVerified or verifiedStart > srcFirst

    float athPv0 = athUseSeed ? (athSeedPvBefore - seedAthPv) : athPvBefore
    float athV0 = athUseSeed ? (athSeedVBefore - seedAthV) : athVBefore
    float atlPv0 = atlUseSeed ? (atlSeedPvBefore - seedAtlPv) : atlPvBefore
    float atlV0 = atlUseSeed ? (atlSeedVBefore - seedAtlV) : atlVBefore
    bool athMissing = (not athUseSeed and dailyOlderAth and not recordVerified) or na(athAnchor)
    bool atlMissing = (not atlUseSeed and dailyOlderAtl and not recordVerified) or na(atlAnchor)
    if recordVerified and not dailyOlderAth
        athMissing := na(athAnchor)
    [athVal, athReason] = f_eventVwap(cumPv, cumV, athPv0, athV0, athInvalid, athMissing, athUseSeed, athAvailable and not athUseSeed)
    [atlVal, atlReason] = f_eventVwap(cumPv, cumV, atlPv0, atlV0, atlInvalid, atlMissing, atlUseSeed, atlAvailable and not atlUseSeed)

    bool shHaveEvent = not na(shEvent) and time >= shEvent
    bool slHaveEvent = not na(slEvent) and time >= slEvent
    [shRaw, shReason0] = f_eventVwap(cumPv, cumV, shPvBefore, shVBefore, shInvalid, shMissing or na(shAnchor), false, false)
    [slRaw, slReason0] = f_eventVwap(cumPv, cumV, slPvBefore, slVBefore, slInvalid, slMissing or na(slAnchor), false, false)
    float shVal = shHaveEvent ? shRaw : na
    float slVal = slHaveEvent ? slRaw : na
    int shReason = shHaveEvent ? shReason0 : RS_NO_EVENT
    int slReason = slHaveEvent ? slReason0 : RS_NO_EVENT

    Snap out = Snap.new()
    out.daily := dailyVal
    out.dailyAnchor := dayAnchor
    out.dailyReason := dailyReason
    out.weekly := weeklyVal
    out.weeklyAnchor := weekAnchor
    out.weeklyReason := weeklyReason
    out.monthly := monthlyVal
    out.monthlyAnchor := monthAnchor
    out.monthlyReason := monthlyReason
    out.ath := athVal
    out.athAnchor := athAnchor
    out.athEvent := athAnchor
    out.athReason := athReason
    out.atl := atlVal
    out.atlAnchor := atlAnchor
    out.atlEvent := atlAnchor
    out.atlReason := atlReason
    out.sh := shVal
    out.shAnchor := shAnchor
    out.shEvent := shEvent
    out.shKnown := shKnown
    out.shReason := shReason
    out.sl := slVal
    out.slAnchor := slAnchor
    out.slEvent := slEvent
    out.slKnown := slKnown
    out.slReason := slReason
    out.srcFirst := srcFirst
    out.srcTime := time
    out.dailyOlderAth := dailyOlderAth ? 1 : 0
    out.dailyOlderAtl := dailyOlderAtl ? 1 : 0
    out.swingConflict := conflict
    out.seededAth := athUseSeed ? 1 : 0
    out.seededAtl := atlUseSeed ? 1 : 0
    out

Snap snap = request.security(syminfo.tickerid, calcTf, f_engine(), barmerge.gaps_off, barmerge.lookahead_off, calc_bars_count = requestedSourceBars)

// request.security kann auf Bar 0 na liefern. Feldzugriff auf na-UDT wirft; Ternary/and schuetzen nicht.
float dailyVal = na
int dailyAnchor = na
int dailyReason = RS_NO_EVENT
float weeklyVal = na
int weeklyAnchor = na
int weeklyReason = RS_NO_EVENT
float monthlyVal = na
int monthlyAnchor = na
int monthlyReason = RS_NO_EVENT
float athVal = na
int athAnchor = na
int athReason = RS_NO_EVENT
float atlVal = na
int atlAnchor = na
int atlReason = RS_NO_EVENT
float shVal = na
int shAnchor = na
int shEvent = na
int shKnown = na
int shReason = RS_NO_EVENT
float slVal = na
int slAnchor = na
int slEvent = na
int slKnown = na
int slReason = RS_NO_EVENT
int srcFirst = na
int dailyOlderAth = 0
int dailyOlderAtl = 0
int swingConflict = 0
if not na(snap)
    dailyVal := snap.daily
    dailyAnchor := snap.dailyAnchor
    dailyReason := snap.dailyReason
    weeklyVal := snap.weekly
    weeklyAnchor := snap.weeklyAnchor
    weeklyReason := snap.weeklyReason
    monthlyVal := snap.monthly
    monthlyAnchor := snap.monthlyAnchor
    monthlyReason := snap.monthlyReason
    athVal := snap.ath
    athAnchor := snap.athAnchor
    athReason := snap.athReason
    atlVal := snap.atl
    atlAnchor := snap.atlAnchor
    atlReason := snap.atlReason
    shVal := snap.sh
    shAnchor := snap.shAnchor
    shEvent := snap.shEvent
    shKnown := snap.shKnown
    shReason := snap.shReason
    slVal := snap.sl
    slAnchor := snap.slAnchor
    slEvent := snap.slEvent
    slKnown := snap.slKnown
    slReason := snap.slReason
    srcFirst := snap.srcFirst
    dailyOlderAth := snap.dailyOlderAth
    dailyOlderAtl := snap.dailyOlderAtl
    swingConflict := snap.swingConflict

f_canShow(int reason) =>
    reason == RS_OK or reason == RS_SEEDED or reason == RS_AVAILABLE

f_star(int reason) =>
    reason == RS_AVAILABLE

var int prevDailyAnchor = na
var int prevWeeklyAnchor = na
var int prevMonthlyAnchor = na
var int prevAthAnchor = na
var int prevAtlAnchor = na

bool breakDaily = not na(dailyAnchor) and not na(prevDailyAnchor) and dailyAnchor != prevDailyAnchor
bool breakWeekly = not na(weeklyAnchor) and not na(prevWeeklyAnchor) and weeklyAnchor != prevWeeklyAnchor
bool breakMonthly = not na(monthlyAnchor) and not na(prevMonthlyAnchor) and monthlyAnchor != prevMonthlyAnchor
bool breakAth = not na(athAnchor) and not na(prevAthAnchor) and athAnchor != prevAthAnchor
bool breakAtl = not na(atlAnchor) and not na(prevAtlAnchor) and atlAnchor != prevAtlAnchor
prevDailyAnchor := dailyAnchor
prevWeeklyAnchor := weeklyAnchor
prevMonthlyAnchor := monthlyAnchor
prevAthAnchor := athAnchor
prevAtlAnchor := atlAnchor

float plotDaily = showDaily and f_canShow(dailyReason) and not breakDaily ? dailyVal : na
float plotWeekly = showWeekly and f_canShow(weeklyReason) and not breakWeekly ? weeklyVal : na
float plotMonthly = showMonthly and f_canShow(monthlyReason) and not breakMonthly ? monthlyVal : na
float plotAth = showAth and f_canShow(athReason) and not breakAth ? athVal : na
float plotAtl = showAtl and f_canShow(atlReason) and not breakAtl ? atlVal : na

plot(plotDaily, "Daily VWAP", f_plotColor(colDaily), 2, plot.style_linebr)
plot(plotWeekly, "Weekly VWAP", f_plotColor(colWeekly), 2, plot.style_linebr, linestyle = plot.linestyle_dashed)
plot(plotMonthly, "Monthly VWAP", f_plotColor(colMonthly), 2, plot.style_linebr, linestyle = plot.linestyle_dashed)
plot(plotAth, "ATH VWAP", f_plotColor(colAth), 2, plot.style_linebr, linestyle = plot.linestyle_dashed)
plot(plotAtl, "ATL VWAP", f_plotColor(colAtl), 2, plot.style_linebr, linestyle = plot.linestyle_dashed)

f_labelText(string kind, int anchorTs, int reason, bool includeDate) =>
    string txt = f_star(reason) ? kind + "* VWAP" : kind + " VWAP"
    if includeDate and not na(anchorTs)
        txt := txt + " " + str.format_time(anchorTs, "dd.MM.yyyy", ANCHOR_TZ)
    if showBasisInLabel
        txt := txt + " [" + calcTf + "m]"
    txt

f_upsertLabel(label id, bool vis, float px, color col, string txt, bool atBarTime = false) =>
    label result = id
    if not vis or na(px)
        if not na(result)
            label.delete(result)
            result := na
    else
        int x = atBarTime ? time : bar_index + extraLabelOffset
        string xlocId = atBarTime ? xloc.bar_time : xloc.bar_index
        if na(result)
            result := label.new(x, px, txt, xlocId, yloc.price, color.new(color.white, 100), label.style_label_left, col, f_labelSize(), text.align_left)
        else
            label.set_xloc(result, x, xlocId)
            label.set_y(result, px)
            label.set_text(result, txt)
            label.set_textcolor(result, col)
            label.set_size(result, f_labelSize())
            label.set_style(result, label.style_label_left)
            label.set_color(result, color.new(color.white, 100))
    result

var label lblDaily = na
var label lblWeekly = na
var label lblMonthly = na
var label lblAth = na
var label lblAtl = na
var label lblSh = na
var label lblSl = na

bool visDailyLbl = showDaily and showRegularLabels and f_canShow(dailyReason) and not na(dailyVal)
bool visWeeklyLbl = showWeekly and showRegularLabels and f_canShow(weeklyReason) and not na(weeklyVal)
bool visMonthlyLbl = showMonthly and showRegularLabels and f_canShow(monthlyReason) and not na(monthlyVal)
bool visAthLbl = showAth and showRegularLabels and f_canShow(athReason) and not na(athVal)
bool visAtlLbl = showAtl and showRegularLabels and f_canShow(atlReason) and not na(atlVal)
bool shCollect = showSwing and f_canShow(shReason) and not na(shVal)
bool slCollect = showSwing and f_canShow(slReason) and not na(slVal)
bool shDraw = shCollect and not na(shKnown) and time >= shKnown
bool slDraw = slCollect and not na(slKnown) and time >= slKnown
bool visShLbl = shDraw and showSwingLabels
bool visSlLbl = slDraw and showSwingLabels

if barstate.islast
    lblDaily := f_upsertLabel(lblDaily, visDailyLbl, dailyVal, colDaily, f_labelText("Daily", dailyAnchor, dailyReason, showAnchorDate))
    lblWeekly := f_upsertLabel(lblWeekly, visWeeklyLbl, weeklyVal, colWeekly, f_labelText("Weekly", weeklyAnchor, weeklyReason, showAnchorDate))
    lblMonthly := f_upsertLabel(lblMonthly, visMonthlyLbl, monthlyVal, colMonthly, f_labelText("Monthly", monthlyAnchor, monthlyReason, showAnchorDate))
    lblAth := f_upsertLabel(lblAth, visAthLbl, athVal, colAth, f_labelText("ATH", athAnchor, athReason, showAnchorDate))
    lblAtl := f_upsertLabel(lblAtl, visAtlLbl, atlVal, colAtl, f_labelText("ATL", atlAnchor, atlReason, showAnchorDate))
    lblSh := f_upsertLabel(lblSh, visShLbl, shVal, colSwing, f_labelText("Swing High", shAnchor, shReason, showAnchorDate), true)
    lblSl := f_upsertLabel(lblSl, visSlLbl, slVal, colSwing, f_labelText("Swing Low", slAnchor, slReason, showAnchorDate), true)

var array<int> shTimes = array.new_int()
var array<float> shVals = array.new_float()
var array<int> slTimes = array.new_int()
var array<float> slVals = array.new_float()
var int shGen = na
var int slGen = na
var polyline polySh = na
var polyline polySl = na

f_collect(array<int> times, array<float> vals, bool vis, float px, int gen, int curGen) =>
    int newGen = curGen
    if not vis
        array.clear(times)
        array.clear(vals)
        newGen := na
    else
        if na(curGen) or gen != curGen
            array.clear(times)
            array.clear(vals)
            newGen := gen
        if array.size(times) == 0 or array.get(times, array.size(times) - 1) != time
            array.push(times, time)
            array.push(vals, px)
            if array.size(times) > SWING_POINT_CAP
                array.shift(times)
                array.shift(vals)
    newGen

shGen := f_collect(shTimes, shVals, shCollect, shVal, shEvent, shGen)
slGen := f_collect(slTimes, slVals, slCollect, slVal, slEvent, slGen)

f_pointsFrom(array<int> times, array<float> vals) =>
    array<chart.point> pts = array.new<chart.point>()
    int n = array.size(times)
    if n >= 2
        for i = 0 to n - 1
            array.push(pts, chart.point.from_time(array.get(times, i), array.get(vals, i)))
    pts

if barstate.islast
    if not na(polySh)
        polyline.delete(polySh)
        polySh := na
    if not na(polySl)
        polyline.delete(polySl)
        polySl := na
    array<chart.point> shPts = f_pointsFrom(shTimes, shVals)
    array<chart.point> slPts = f_pointsFrom(slTimes, slVals)
    if shDraw and array.size(shPts) >= 2
        polySh := polyline.new(shPts, false, false, xloc.bar_time, colSwing, na, line.style_solid, swingWidth)
    if slDraw and array.size(slPts) >= 2
        polySl := polyline.new(slPts, false, false, xloc.bar_time, colSwing, na, line.style_solid, swingWidth)

f_reasonText(string name, int reason, int srcFirst, bool older) =>
    string msg = ""
    if reason == RS_MISSING_PREFIX
        msg := name + " nicht berechenbar: Anker vor " + calcTf + "m-Historie" + (na(srcFirst) ? "." : " (" + str.format_time(srcFirst, "dd.MM.yyyy HH:mm", ANCHOR_TZ) + ").")
    else if reason == RS_NO_VOLUME
        msg := name + ": kein positives Volumen seit Anker."
    else if reason == RS_INVALID
        msg := name + ": ungueltiger Preis- oder Volumenbeitrag."
    else if reason == RS_NO_EVENT
        msg := name + ": noch kein bestaetigter Swing."
    else if reason == RS_SEEDED
        msg := name + ": mit historischem Startbestand."
    else if reason == RS_AVAILABLE
        msg := name + "*: Rekordsuche nur ab verfuegbarer Historie."
    if older
        msg := msg + (msg == "" ? "" : " ") + name + ": 1D-Kandidat aelter als Intraday-Historie."
    msg

bool chartSmaller = timeframe.in_seconds() < timeframe.in_seconds(calcTf)
bool swingTfSmall = timeframe.in_seconds(swingTf) < timeframe.in_seconds(calcTf)
string extraHint = ""
if chartSmaller
    extraHint := "Chart-TF kleiner als Berechnungsintervall; keine zusaetzliche Genauigkeit."
if swingTfSmall
    extraHint := extraHint + (extraHint == "" ? "" : " ") + "Swing-TF ist kleiner als die Berechnungsbasis."
if swingConflict == 1
    extraHint := extraHint + (extraHint == "" ? "" : " ") + "Swing: Konflikt gleiche Pivotzeit, bisheriges Ereignis beibehalten."

var table notice = na
if barstate.islast
    array<string> rows = array.new_string()
    if showDaily
        string m = f_reasonText("Daily", dailyReason, srcFirst, false)
        if m != "" and (hintMode == "Details" or dailyReason == RS_MISSING_PREFIX or dailyReason == RS_INVALID or dailyReason == RS_NO_VOLUME)
            array.push(rows, m)
    if showWeekly
        string m = f_reasonText("Weekly", weeklyReason, srcFirst, false)
        if m != "" and (hintMode == "Details" or weeklyReason == RS_MISSING_PREFIX or weeklyReason == RS_INVALID or weeklyReason == RS_NO_VOLUME)
            array.push(rows, m)
    if showMonthly
        string m = f_reasonText("Monthly", monthlyReason, srcFirst, false)
        if m != "" and (hintMode == "Details" or monthlyReason == RS_MISSING_PREFIX or monthlyReason == RS_INVALID or monthlyReason == RS_NO_VOLUME)
            array.push(rows, m)
    if showAth
        string m = f_reasonText("ATH", athReason, srcFirst, dailyOlderAth == 1)
        if m != "" and (hintMode == "Details" or athReason != RS_OK)
            array.push(rows, m)
    if showAtl
        string m = f_reasonText("ATL", atlReason, srcFirst, dailyOlderAtl == 1)
        if m != "" and (hintMode == "Details" or atlReason != RS_OK)
            array.push(rows, m)
    if showSwing
        if hintMode == "Details" or shReason == RS_MISSING_PREFIX or shReason == RS_INVALID
            string m = f_reasonText("Swing High", shReason, srcFirst, false)
            if m != ""
                array.push(rows, m)
        if hintMode == "Details" or slReason == RS_MISSING_PREFIX or slReason == RS_INVALID
            string m = f_reasonText("Swing Low", slReason, srcFirst, false)
            if m != ""
                array.push(rows, m)
    if extraHint != ""
        array.push(rows, extraHint)
    int n = array.size(rows)
    if n == 0
        if not na(notice)
            table.delete(notice)
            notice := na
    else
        if not na(notice)
            table.delete(notice)
        notice := table.new(position.top_right, 1, n)
        for i = 0 to n - 1
            table.cell(notice, 0, i, array.get(rows, i), text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
