//@version=6
indicator("oTrade VWAP", overlay = true, dynamic_requests = true, max_labels_count = 20)

// Overlay-Engine im festen Berechnungs-Timeframe. Plots und Zeichenobjekte nur im Chart-Kontext.

const string ANCHOR_TZ = "UTC"
const int DAY_MS = 86400000
const int RS_OK = 0
const int RS_MISSING_PREFIX = 1
const int RS_NO_VOLUME = 2
const int RS_INVALID = 3
const int DAY_RECORD_BARS = 15000
const string ATH_TF = "60"

string GRP_VWAP = "VWAP"
string GRP_LABEL = "Beschriftung"
string GRP_CALC = "Berechnung und Daten"

bool showDaily = input.bool(false, "Daily VWAP", inline = "daily", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colDaily = input.color(color.new(#FFEB3B, 0), "", inline = "daily", group = GRP_VWAP, display = display.none)
bool showWeekly = input.bool(true, "Weekly VWAP", inline = "weekly", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colWeekly = input.color(color.new(#4CAF50, 0), "", inline = "weekly", group = GRP_VWAP, display = display.none)
bool showMonthly = input.bool(true, "Monthly VWAP", inline = "monthly", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colMonthly = input.color(color.new(#2962FF, 0), "", inline = "monthly", group = GRP_VWAP, display = display.none)
bool showAth = input.bool(false, "ATH VWAP", inline = "ath", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colAth = input.color(color.new(#FFFFFF, 0), "", inline = "ath", group = GRP_VWAP, display = display.none)
bool showAtl = input.bool(false, "ATL VWAP", inline = "atl", group = GRP_VWAP, tooltip = "Steuert Linie und zugehoeriges Textlabel gemeinsam. Die Style-Checkbox betrifft nur den Plot.", display = display.none)
color colAtl = input.color(color.new(#FFFFFF, 0), "", inline = "atl", group = GRP_VWAP, display = display.none)
bool showRegularLabels = input.bool(true, "Label VWAPs", group = GRP_VWAP, display = display.none)

bool showAnchorDate = input.bool(true, "Ankerdatum anzeigen", group = GRP_LABEL, tooltip = "Datum des Berechnungsbeginns in UTC.", display = display.none)
string labelSizeName = input.string("Klein", "Label-Groesse", options = ["Sehr klein", "Klein", "Normal"], group = GRP_LABEL, display = display.none)
int extraLabelOffset = input.int(0, "Zusaetzlicher Abstand (Kerzen)", minval = 0, maxval = 30, group = GRP_LABEL, tooltip = "0 verankert das Label direkt am Linienende. Zusaetzliche Kerzenabstaende veraendern sich beim Zoomen.", display = display.none)
bool showBasisInLabel = input.bool(false, "Berechnungsbasis im Label", group = GRP_LABEL, display = display.none)

string calcTf = input.string("1", "Berechnungsintervall", options = ["1", "5", "15", "60"], group = GRP_CALC, tooltip = "Bestimmt die Preis-/Volumenbasis. Ein anderes Intervall kann einen anderen VWAP ergeben.", display = display.none)
string priceSrc = input.string("HLC3", "Preisquelle", options = ["HLC3", "HL2", "Close", "OHLC4"], group = GRP_CALC, display = display.none)
string hintMode = input.string("Nur bei Einschraenkungen", "Datenhinweise", options = ["Nur bei Einschraenkungen", "Details"], group = GRP_CALC, display = display.none)
int requestedSourceBars = input.int(100000, "Quellhistorie anfordern", minval = 1, maxval = 200000, group = GRP_CALC, display = display.none)

type Snap
    float daily
    int dailyAnchor
    int dailyReason
    float weekly
    int weeklyAnchor
    int weeklyReason
    float monthly
    int monthlyAnchor
    int monthlyReason
    int srcFirst

type DailyRec
    float athPx
    int athT
    float atlPx
    int atlT
    int firstT

type RecordSnap
    float ath
    int athAnchor
    int athReason
    float atl
    int atlAnchor
    int atlReason
    int srcFirst

f_utcDayStart(int ts) =>
    timestamp(ANCHOR_TZ, year(ts, ANCHOR_TZ), month(ts, ANCHOR_TZ), dayofmonth(ts, ANCHOR_TZ), 0, 0)

f_utcWeekStart(int ts) =>
    int dayStart = f_utcDayStart(ts)
    int daysSinceMonday = (dayofweek(ts, ANCHOR_TZ) - dayofweek.monday + 7) % 7
    dayStart - daysSinceMonday * DAY_MS

f_utcMonthStart(int ts) =>
    timestamp(ANCHOR_TZ, year(ts, ANCHOR_TZ), month(ts, ANCHOR_TZ), 1, 0, 0)

f_price() =>
    switch priceSrc
        "HL2" => hl2
        "Close" => close
        "OHLC4" => ohlc4
        => hlc3

f_labelSize() =>
    switch labelSizeName
        "Sehr klein" => size.tiny
        "Normal" => size.normal
        => size.small

f_plotColor(color userColor) =>
    color.new(userColor, color.t(userColor))

f_periodVwap(float pv, float vol, bool invalid, bool complete) =>
    int reason = RS_OK
    float value = na
    if invalid
        reason := RS_INVALID
    else if not complete
        reason := RS_MISSING_PREFIX
    else if vol <= 0
        reason := RS_NO_VOLUME
    else
        value := pv / vol
    [value, reason]

f_eventVwap(float cumPv, float cumV, float pvBefore, float vBefore, bool invalid, bool missing) =>
    int reason = RS_OK
    float value = na
    float den = cumV - vBefore
    if missing
        reason := RS_MISSING_PREFIX
    else if invalid
        reason := RS_INVALID
    else if na(pvBefore) or na(vBefore) or den <= 0
        reason := RS_NO_VOLUME
    else
        value := (cumPv - pvBefore) / den
    [value, reason]

f_dailyPack() =>
    var float recH = na
    var int recHt = na
    var float recL = na
    var int recLt = na
    var int firstT = na
    if na(firstT)
        firstT := time
    if na(recH) or high > recH
        recH := high
        recHt := time
    if na(recL) or low < recL
        recL := low
        recLt := time
    [recH, recHt, recL, recLt, firstT]

f_dailyRec() =>
    [athPx, athT, atlPx, atlT, firstT] = f_dailyPack()
    DailyRec rec = DailyRec.new()
    rec.athPx := athPx
    rec.athT := athT
    rec.atlPx := atlPx
    rec.atlT := atlT
    rec.firstT := firstT
    rec

f_engine() =>
    var int srcFirst = na
    var int prevDay = na
    var int prevWeek = na
    var int prevMonth = na
    var int dayAnchor = na
    var int weekAnchor = na
    var int monthAnchor = na
    var float dayPv = 0.0
    var float dayV = 0.0
    var float weekPv = 0.0
    var float weekV = 0.0
    var float monthPv = 0.0
    var float monthV = 0.0
    var bool dayInvalid = false
    var bool weekInvalid = false
    var bool monthInvalid = false

    if na(srcFirst)
        srcFirst := time

    int dayKey = f_utcDayStart(time)
    int weekKey = f_utcWeekStart(time)
    int monthKey = f_utcMonthStart(time)
    bool newDay = na(prevDay) or dayKey != prevDay
    bool newWeek = na(prevWeek) or weekKey != prevWeek
    bool newMonth = na(prevMonth) or monthKey != prevMonth

    if newDay
        dayAnchor := dayKey
        dayPv := 0.0
        dayV := 0.0
        dayInvalid := false
    if newWeek
        weekAnchor := weekKey
        weekPv := 0.0
        weekV := 0.0
        weekInvalid := false
    if newMonth
        monthAnchor := monthKey
        monthPv := 0.0
        monthV := 0.0
        monthInvalid := false

    float p = f_price()
    float v = volume
    int contribState = 0
    if na(v) or v < 0 or (v > 0 and na(p))
        contribState := 2
    else if v > 0
        contribState := 1

    if contribState == 2
        dayInvalid := true
        weekInvalid := true
        monthInvalid := true
    else if contribState == 1
        float pv = p * v
        dayPv += pv
        dayV += v
        weekPv += pv
        weekV += v
        monthPv += pv
        monthV += v

    prevDay := dayKey
    prevWeek := weekKey
    prevMonth := monthKey

    [dailyVal, dailyReason] = f_periodVwap(dayPv, dayV, dayInvalid, srcFirst <= dayAnchor)
    [weeklyVal, weeklyReason] = f_periodVwap(weekPv, weekV, weekInvalid, srcFirst <= weekAnchor)
    [monthlyVal, monthlyReason] = f_periodVwap(monthPv, monthV, monthInvalid, srcFirst <= monthAnchor)

    Snap out = Snap.new()
    out.daily := dailyVal
    out.dailyAnchor := dayAnchor
    out.dailyReason := dailyReason
    out.weekly := weeklyVal
    out.weeklyAnchor := weekAnchor
    out.weeklyReason := weeklyReason
    out.monthly := monthlyVal
    out.monthlyAnchor := monthAnchor
    out.monthlyReason := monthlyReason
    out.srcFirst := srcFirst
    out

f_recordEngine() =>
    DailyRec dailyRec = request.security(syminfo.tickerid, "1D", f_dailyRec(), barmerge.gaps_off, barmerge.lookahead_off)
    int dAthT = na
    int dAtlT = na
    if not na(dailyRec)
        dAthT := dailyRec.athT
        dAtlT := dailyRec.atlT

    var int srcFirst = na
    var float cumPv = 0.0
    var float cumV = 0.0
    var int athLocked = na
    var int atlLocked = na
    var float athPvBefore = na
    var float athVBefore = na
    var float atlPvBefore = na
    var float atlVBefore = na
    var bool athInvalid = false
    var bool atlInvalid = false

    if na(srcFirst)
        srcFirst := time

    bool athInHistory = not na(dAthT) and dAthT >= srcFirst
    bool atlInHistory = not na(dAtlT) and dAtlT >= srcFirst

    if athInHistory and (na(athLocked) or dAthT != athLocked)
        athLocked := dAthT
        athPvBefore := na
        athVBefore := na
        athInvalid := false
    if not athInHistory
        athLocked := na
        athPvBefore := na
        athVBefore := na
    if atlInHistory and (na(atlLocked) or dAtlT != atlLocked)
        atlLocked := dAtlT
        atlPvBefore := na
        atlVBefore := na
        atlInvalid := false
    if not atlInHistory
        atlLocked := na
        atlPvBefore := na
        atlVBefore := na

    float p = f_price()
    float v = volume
    int contribState = 0
    if na(v) or v < 0 or (v > 0 and na(p))
        contribState := 2
    else if v > 0
        contribState := 1

    bool athInclude = athInHistory and not na(athLocked) and time >= athLocked
    bool atlInclude = atlInHistory and not na(atlLocked) and time >= atlLocked
    if contribState == 2
        if athInclude
            athInvalid := true
        if atlInclude
            atlInvalid := true
    else if contribState == 1
        float pv = p * v
        if athInclude and na(athPvBefore)
            athPvBefore := cumPv
            athVBefore := cumV
        if atlInclude and na(atlPvBefore)
            atlPvBefore := cumPv
            atlVBefore := cumV
        cumPv += pv
        cumV += v

    int athOutAnchor = athInHistory ? athLocked : dAthT
    int atlOutAnchor = atlInHistory ? atlLocked : dAtlT
    [athVal, athReason] = f_eventVwap(cumPv, cumV, athPvBefore, athVBefore, athInvalid, not athInHistory)
    [atlVal, atlReason] = f_eventVwap(cumPv, cumV, atlPvBefore, atlVBefore, atlInvalid, not atlInHistory)

    RecordSnap out = RecordSnap.new()
    out.ath := athVal
    out.athAnchor := athOutAnchor
    out.athReason := athReason
    out.atl := atlVal
    out.atlAnchor := atlOutAnchor
    out.atlReason := atlReason
    out.srcFirst := srcFirst
    out

Snap snap = request.security(syminfo.tickerid, calcTf, f_engine(), barmerge.gaps_off, barmerge.lookahead_off, calc_bars_count = requestedSourceBars)
DailyRec dailyRec = request.security(syminfo.tickerid, "1D", f_dailyRec(), barmerge.gaps_off, barmerge.lookahead_off, calc_bars_count = DAY_RECORD_BARS)
RecordSnap recSnap = request.security(syminfo.tickerid, ATH_TF, f_recordEngine(), barmerge.gaps_off, barmerge.lookahead_off, calc_bars_count = requestedSourceBars)

// request.security kann auf Bar 0 na liefern. Feldzugriff auf na-UDT wirft; Ternary/and schuetzen nicht.
float dailyVal = na
int dailyAnchor = na
int dailyReason = na
float weeklyVal = na
int weeklyAnchor = na
int weeklyReason = na
float monthlyVal = na
int monthlyAnchor = na
int monthlyReason = na
float athVal = na
int athAnchor = na
int athReason = na
float atlVal = na
int atlAnchor = na
int atlReason = na
int srcFirst = na
int athSrcFirst = na
int dAthT = na
int dAtlT = na
if not na(snap)
    dailyVal := snap.daily
    dailyAnchor := snap.dailyAnchor
    dailyReason := snap.dailyReason
    weeklyVal := snap.weekly
    weeklyAnchor := snap.weeklyAnchor
    weeklyReason := snap.weeklyReason
    monthlyVal := snap.monthly
    monthlyAnchor := snap.monthlyAnchor
    monthlyReason := snap.monthlyReason
    srcFirst := snap.srcFirst
if not na(dailyRec)
    dAthT := dailyRec.athT
    dAtlT := dailyRec.atlT
if not na(recSnap)
    athVal := recSnap.ath
    athAnchor := recSnap.athAnchor
    athReason := recSnap.athReason
    atlVal := recSnap.atl
    atlAnchor := recSnap.atlAnchor
    atlReason := recSnap.atlReason
    athSrcFirst := recSnap.srcFirst

bool athCovered = not na(dAthT) and not na(athSrcFirst) and dAthT >= athSrcFirst
bool atlCovered = not na(dAtlT) and not na(athSrcFirst) and dAtlT >= athSrcFirst
if not athCovered
    athVal := na
    athReason := RS_MISSING_PREFIX
    athAnchor := dAthT
if not atlCovered
    atlVal := na
    atlReason := RS_MISSING_PREFIX
    atlAnchor := dAtlT

f_canShow(int reason) =>
    reason == RS_OK

var int prevDailyAnchor = na
var int prevWeeklyAnchor = na
var int prevMonthlyAnchor = na
var int prevAthAnchor = na
var int prevAtlAnchor = na

bool breakDaily = not na(dailyAnchor) and not na(prevDailyAnchor) and dailyAnchor != prevDailyAnchor
bool breakWeekly = not na(weeklyAnchor) and not na(prevWeeklyAnchor) and weeklyAnchor != prevWeeklyAnchor
bool breakMonthly = not na(monthlyAnchor) and not na(prevMonthlyAnchor) and monthlyAnchor != prevMonthlyAnchor
bool breakAth = not na(athAnchor) and not na(prevAthAnchor) and athAnchor != prevAthAnchor
bool breakAtl = not na(atlAnchor) and not na(prevAtlAnchor) and atlAnchor != prevAtlAnchor
prevDailyAnchor := dailyAnchor
prevWeeklyAnchor := weeklyAnchor
prevMonthlyAnchor := monthlyAnchor
prevAthAnchor := athAnchor
prevAtlAnchor := atlAnchor

float plotDaily = showDaily and f_canShow(dailyReason) and not breakDaily ? dailyVal : na
float plotWeekly = showWeekly and f_canShow(weeklyReason) and not breakWeekly ? weeklyVal : na
float plotMonthly = showMonthly and f_canShow(monthlyReason) and not breakMonthly ? monthlyVal : na
float plotAth = showAth and f_canShow(athReason) and not breakAth ? athVal : na
float plotAtl = showAtl and f_canShow(atlReason) and not breakAtl ? atlVal : na

plot(plotDaily, "Daily VWAP", f_plotColor(colDaily), 2, plot.style_linebr)
plot(plotWeekly, "Weekly VWAP", f_plotColor(colWeekly), 2, plot.style_linebr, linestyle = plot.linestyle_dashed)
plot(plotMonthly, "Monthly VWAP", f_plotColor(colMonthly), 2, plot.style_linebr, linestyle = plot.linestyle_dashed)
plot(plotAth, "ATH VWAP", f_plotColor(colAth), 2, plot.style_linebr, linestyle = plot.linestyle_dashed)
plot(plotAtl, "ATL VWAP", f_plotColor(colAtl), 2, plot.style_linebr, linestyle = plot.linestyle_dashed)

f_tfLabel(string tf) =>
    tf == "1D" ? "1D" : tf + "m"

f_labelText(string kind, int anchorTs, bool includeDate, string basisTf) =>
    string txt = kind + " VWAP"
    if includeDate and not na(anchorTs)
        txt := txt + " " + str.format_time(anchorTs, "dd.MM.yyyy", ANCHOR_TZ)
    if showBasisInLabel
        txt := txt + " [" + basisTf + "]"
    txt

f_upsertLabel(label id, bool vis, float px, color col, string txt, int xTime = na) =>
    label result = id
    if not vis or na(px)
        if not na(result)
            label.delete(result)
            result := na
    else
        int x = na(xTime) ? bar_index + extraLabelOffset : xTime
        string xlocId = na(xTime) ? xloc.bar_index : xloc.bar_time
        if na(result)
            result := label.new(x, px, txt, xlocId, yloc.price, color.new(color.white, 100), label.style_label_left, col, f_labelSize(), text.align_left)
        else
            label.set_xloc(result, x, xlocId)
            label.set_y(result, px)
            label.set_text(result, txt)
            label.set_textcolor(result, col)
            label.set_size(result, f_labelSize())
            label.set_style(result, label.style_label_left)
            label.set_color(result, color.new(color.white, 100))
    result

var label lblDaily = na
var label lblWeekly = na
var label lblMonthly = na
var label lblAth = na
var label lblAtl = na

bool visDailyLbl = showDaily and showRegularLabels and f_canShow(dailyReason) and not na(dailyVal)
bool visWeeklyLbl = showWeekly and showRegularLabels and f_canShow(weeklyReason) and not na(weeklyVal)
bool visMonthlyLbl = showMonthly and showRegularLabels and f_canShow(monthlyReason) and not na(monthlyVal)
bool visAthLbl = showAth and showRegularLabels and f_canShow(athReason) and not na(athVal)
bool visAtlLbl = showAtl and showRegularLabels and f_canShow(atlReason) and not na(atlVal)

if barstate.islast
    lblDaily := f_upsertLabel(lblDaily, visDailyLbl, dailyVal, colDaily, f_labelText("Daily", dailyAnchor, showAnchorDate, f_tfLabel(calcTf)))
    lblWeekly := f_upsertLabel(lblWeekly, visWeeklyLbl, weeklyVal, colWeekly, f_labelText("Weekly", weeklyAnchor, showAnchorDate, f_tfLabel(calcTf)))
    lblMonthly := f_upsertLabel(lblMonthly, visMonthlyLbl, monthlyVal, colMonthly, f_labelText("Monthly", monthlyAnchor, showAnchorDate, f_tfLabel(calcTf)))
    lblAth := f_upsertLabel(lblAth, visAthLbl, athVal, colAth, f_labelText("ATH", athAnchor, showAnchorDate, f_tfLabel(ATH_TF)))
    lblAtl := f_upsertLabel(lblAtl, visAtlLbl, atlVal, colAtl, f_labelText("ATL", atlAnchor, showAnchorDate, f_tfLabel(ATH_TF)))

f_reasonText(string name, int reason, int histStart, string tfLabel, int anchorTs) =>
    string msg = ""
    if reason == RS_MISSING_PREFIX
        string histTxt = na(histStart) ? "." : " (ab " + str.format_time(histStart, "dd.MM.yyyy HH:mm", ANCHOR_TZ) + ")."
        if na(anchorTs)
            msg := name + " nicht berechenbar: Anker vor " + tfLabel + "-Historie" + histTxt
        else
            msg := name + " nicht berechenbar: Daily-Anker " + str.format_time(anchorTs, "dd.MM.yyyy", ANCHOR_TZ) + " liegt vor " + tfLabel + "-Historie" + histTxt
    else if reason == RS_NO_VOLUME
        msg := name + ": kein positives Volumen seit Anker."
    else if reason == RS_INVALID
        msg := name + ": ungueltiger Preis- oder Volumenbeitrag."
    msg

bool chartSmaller = timeframe.in_seconds() < timeframe.in_seconds(calcTf)
string extraHint = ""
if chartSmaller
    extraHint := "Chart-TF kleiner als Berechnungsintervall; keine zusaetzliche Genauigkeit."

var table notice = na
if barstate.islast
    array<string> rows = array.new_string()
    if showDaily
        string m = f_reasonText("Daily", dailyReason, srcFirst, f_tfLabel(calcTf), na)
        if m != "" and (hintMode == "Details" or dailyReason == RS_MISSING_PREFIX or dailyReason == RS_INVALID or dailyReason == RS_NO_VOLUME)
            array.push(rows, m)
    if showWeekly
        string m = f_reasonText("Weekly", weeklyReason, srcFirst, f_tfLabel(calcTf), na)
        if m != "" and (hintMode == "Details" or weeklyReason == RS_MISSING_PREFIX or weeklyReason == RS_INVALID or weeklyReason == RS_NO_VOLUME)
            array.push(rows, m)
    if showMonthly
        string m = f_reasonText("Monthly", monthlyReason, srcFirst, f_tfLabel(calcTf), na)
        if m != "" and (hintMode == "Details" or monthlyReason == RS_MISSING_PREFIX or monthlyReason == RS_INVALID or monthlyReason == RS_NO_VOLUME)
            array.push(rows, m)
    if showAth
        string m = f_reasonText("ATH", athReason, athSrcFirst, f_tfLabel(ATH_TF), dAthT)
        if m != "" and (hintMode == "Details" or athReason != RS_OK)
            array.push(rows, m)
    if showAtl
        string m = f_reasonText("ATL", atlReason, athSrcFirst, f_tfLabel(ATH_TF), dAtlT)
        if m != "" and (hintMode == "Details" or atlReason != RS_OK)
            array.push(rows, m)
    if extraHint != ""
        array.push(rows, extraHint)
    int n = array.size(rows)
    if n == 0
        if not na(notice)
            table.delete(notice)
            notice := na
    else
        if not na(notice)
            table.delete(notice)
        notice := table.new(position.top_right, 1, n)
        for i = 0 to n - 1
            table.cell(notice, 0, i, array.get(rows, i), text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
